# 複製到私人操作目錄後才部署；不要把 token 或實際 tunnel URL 提交到 Git。
name = "dungeonq-pitching-lab"
main = "participant-edge.mjs"
compatibility_date = "2026-05-12"
workers_dev = false
preview_urls = false
routes = [{ pattern = "dungeonq.talkidino.com", custom_domain = true }]

[observability]
enabled = false

[vars]
LAB_ENABLED = "false"
ENABLED_UNTIL = "1970-01-01T00:00:00.000Z"
TUNNEL_ORIGIN = "https://disabled.trycloudflare.com"
