{
  "name": "dungeonq-amazon",
  "version": "0.11.0",
  "private": true,
  "description": "Persistent synthetic deception runtime, assistant governance and causal studies with bounded protocol adapters and replayable evidence.",
  "license": "Apache-2.0",
  "author": "DungeonQ contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ranopha/dungeonq-amazon.git"
  },
  "homepage": "https://github.com/Ranopha/dungeonq-amazon#readme",
  "bugs": {
    "url": "https://github.com/Ranopha/dungeonq-amazon/issues"
  },
  "keywords": [
    "webmcp",
    "cybersecurity",
    "deception",
    "deterministic",
    "synthetic-testing"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "email:proof": "node scripts/email-proof.mjs",
    "defense": "node scripts/defense.mjs",
    "defense:workspace": "node scripts/defense.mjs --presentation orders-workspace/v1",
    "workspace:verify": "node scripts/workspace-pilot-verify.mjs",
    "defense:proof": "node scripts/defense-proof.mjs",
    "test:defense": "node --test tests/defense-*.test.mjs",
    "topology": "node scripts/topology.mjs",
    "topology:proof": "node scripts/topology-proof.mjs",
    "topology:verify": "node cli/topology-verify.mjs",
    "test:topology": "node --test tests/topology-*.test.mjs",
    "study": "node scripts/study.mjs",
    "study:proof": "node scripts/study-proof.mjs",
    "study:verify": "node cli/study-verify.mjs",
    "test:study": "node --test tests/study-*.test.mjs",
    "world": "node scripts/world.mjs",
    "test:world": "node --test tests/world-*.test.mjs",
    "world:proof": "node scripts/world-proof.mjs",
    "world:verify": "node cli/world-verify.mjs",
    "astra": "node scripts/astra.mjs",
    "test:astra": "node --test tests/astra.test.mjs",
    "astra:proof": "node scripts/astra-proof.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo:proof": "node scripts/demo-proof.mjs",
    "mcp:client": "node scripts/mcp-client.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "amazon": "node scripts/amazon.mjs",
    "verify:assistant-evidence": "node scripts/verify-assistant-evidence.mjs",
    "test:amazon": "node --test tests/response-governance.test.mjs tests/mcp-server.test.mjs tests/assistant.test.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --test",
    "test:governance": "node --test tests/governance-core.test.mjs",
    "test:workbench": "node --test tests/workbench.test.mjs",
    "workbench": "node scripts/workbench.mjs",
    "acceptance:company": "node scripts/company-acceptance.mjs",
    "verify:company-report": "node scripts/verify-company-report.mjs",
    "verify": "node scripts/verify.mjs",
    "audit": "node scripts/audit.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run verify && npm run audit && npm run typecheck && npm run build",
    "simulate": "node cli/run.mjs",
    "serve": "node scripts/serve.mjs",
    "runtime": "node scripts/runtime.mjs",
    "runtime:proof": "node scripts/runtime-proof.mjs",
    "runtime:gate": "node scripts/runtime-gate.mjs",
    "runtime:isolation": "node scripts/runtime-isolation.mjs",
    "test:runtime": "node --test tests/runtime-*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "pg-gateway": "0.3.0-beta.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "ssh2": "1.17.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.131.1"
  }
}
